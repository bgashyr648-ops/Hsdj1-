const { cmd } = require('../command');

cmd({
    pattern: "fb",
    alias: ["facebook", "fbdl"],
    desc: "Download Facebook videos",
    category: "download",
    react: "📥",
    filename: __filename
},
async (conn, mek, m, { from, q, reply }) => {
    try {
        console.log("📥 FB command triggered with query:", q);
        
        if (!q) {
            return reply("Please provide a Facebook link! Example: .fb [link]");
        }

        await reply("Processing your Facebook request...");

        let res = await fetchJson(`https://api.siputzx.my.id/api/d/facebook?url=${encodeURIComponent(q)}`);
        
        if (!res || !res.status || !res.data) {
            return reply("Failed to fetch video from API!");
        }

        let videoUrl = res.data.hd || res.data.sd;

        await conn.sendMessage(
            from,
            {
                video: { url: videoUrl },
                caption: `🎬 *FACEBOOK DOWNLOADER*\n\n> *© Powered by BAGGA-SHER-MD*`
            },
            { quoted: mek }
        );

    } catch (error) {
        console.error('FB ERROR:', error);
        return reply(`Error: ${error.message}`);
    }
});
