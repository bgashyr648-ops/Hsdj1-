const { cmd } = require('../command');
const axios = require('axios');

cmd({
    pattern: "fb",
    alias: ["facebook", "fbdl"],
    desc: "Download Facebook videos",
    category: "download",
    react: "📥",
    filename: __filename
},
async (conn, mek, m, { from, q, reply }) => {
    try {
        if (!q) {
            return reply("Please provide a valid Facebook video link!\nExample: .fb https://www.facebook.com/...");
        }
        if (!q.includes('facebook.com') && !q.includes('fb.watch')) {
            return reply("Invalid Facebook URL!");
        }

        await reply("Downloading video, please wait...");

        let response = await axios.get(`https://api.siputzx.my.id/api/d/facebook?url=${encodeURIComponent(q)}`);
        let res = response.data;

        if (!res || !res.status || !res.data) {
            return reply("Failed to fetch video. Please try another link!");
        }

        let videoUrl = res.data.hd || res.data.sd;

        await conn.sendMessage(
            from,
            {
                video: { url: videoUrl },
                caption: `🎬 *FACEBOOK DOWNLOADER*\n\n> *© Powered by BAGGA-SHER-MD*`
            },
            { quoted: mek }
        );

    } catch (error) {
        console.error('FB ERROR:', error);
        return reply(`Error: ${error.message}`);
    }
});
